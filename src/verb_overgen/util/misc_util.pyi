from collections.abc import Callable
from typing import Any, ClassVar, Literal, overload

@overload
def affirm[T](value: T) -> T: ...
@overload
def affirm[T](value: T | None, predicate: type[non_null]) -> T: ...
@overload
def affirm[T](value: Any, predicate: type[of_type[T]]) -> T: ...
@overload
def affirm[T](value: T, predicate: Callable[[T], bool]) -> T: ...
@overload
def affirm[T](value: T, predicate: Callable[[T], Any]) -> T: ...
@overload
def affirm[T](value: T, predicate: bool) -> T: ...
@overload
def affirm[T](value: T, predicate: Any) -> T: ...
@overload
def affirm[T](value: T, predicate = None) -> T: ...

class non_null:
    @overload
    def __new__(cls, value: None) -> Literal[False]: ...
    @overload
    def __new__(cls, value: object | None) -> bool: ...

class of_type[T]:
    ty: ClassVar[type] = object

    @overload
    def __new__(cls, value: T) -> Literal[True]: ...
    @overload
    def __new__(cls, value: Any) -> bool: ...

    @classmethod
    def __class_getitem__[U](cls, item: type[U]) -> type[of_type[U]]: ...

    @classmethod
    def type[U](cls, ty: type[U]) -> type[of_type[U]]: ...
